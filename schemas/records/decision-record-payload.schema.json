{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:battlebelief:schema:record:decision-record-payload:v1",
  "title": "BattleBelief Decision Record payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_schema_version",
    "record_status",
    "run_context_digest",
    "battle_id_digest",
    "decision_index",
    "request_identity",
    "observed_state_digest",
    "safe_submission_set_digest",
    "selected_submission",
    "submission_provenance",
    "fallback_or_error_class",
    "policy_or_arm_id",
    "runtime_and_contract_digests"
  ],
  "properties": {
    "record_schema_version": {"const": 1},
    "record_status": {
      "enum": [
        "submitted",
        "wait_noop",
        "policy_rejected",
        "action_gate_rejected",
        "command_encoding_failed",
        "send_failed",
        "session_aborted",
        "superseded_before_selection",
        "terminally_discarded",
        "reconciliation_rejected"
      ]
    },
    "run_context_digest": {"$ref": "#/$defs/digest"},
    "battle_id_digest": {"$ref": "#/$defs/digest"},
    "decision_index": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "request_identity": {"$ref": "#/$defs/requestIdentity"},
    "observed_state_digest": {"$ref": "#/$defs/digest"},
    "safe_submission_set_digest": {"$ref": "#/$defs/digest"},
    "selected_submission": {"anyOf": [{"$ref": "#/$defs/submission"}, {"type": "null"}]},
    "submission_provenance": {
      "anyOf": [
        {"enum": ["explicit_request", "server_default"]},
        {"type": "null"}
      ]
    },
    "fallback_or_error_class": {
      "anyOf": [
        {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
        {"type": "null"}
      ]
    },
    "policy_or_arm_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"},
    "runtime_and_contract_digests": {"$ref": "#/$defs/runtimeAndContractDigests"}
  },
  "allOf": [
    {
      "if": {"properties": {"record_status": {"const": "submitted"}}},
      "then": {
        "required": ["selected_submission", "submission_provenance"],
        "properties": {"selected_submission": {"not": {"type": "null"}}, "submission_provenance": {"enum": ["explicit_request", "server_default"]}, "fallback_or_error_class": {"type": "null"}}
      }
    },
    {
      "if": {"properties": {"record_status": {"const": "wait_noop"}}},
      "then": {"properties": {"selected_submission": {"type": "null"}, "submission_provenance": {"type": "null"}, "fallback_or_error_class": {"type": "null"}}}
    },
    {
      "if": {"properties": {"record_status": {"enum": ["policy_rejected", "superseded_before_selection", "terminally_discarded", "reconciliation_rejected"]}}},
      "then": {"properties": {"selected_submission": {"type": "null"}, "submission_provenance": {"type": "null"}, "fallback_or_error_class": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"}}}
    },
    {
      "if": {"properties": {"record_status": {"enum": ["action_gate_rejected", "command_encoding_failed", "send_failed"]}}},
      "then": {"properties": {"selected_submission": {"not": {"type": "null"}}, "submission_provenance": {"enum": ["explicit_request", "server_default"]}, "fallback_or_error_class": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"}}}
    },
    {
      "if": {"properties": {"record_status": {"const": "session_aborted"}}},
      "then": {"properties": {"fallback_or_error_class": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"}}}
    },
    {
      "if": {"properties": {"submission_provenance": {"const": "explicit_request"}}},
      "then": {"properties": {"selected_submission": {"oneOf": [{"$ref": "#/$defs/moveSubmission"}, {"$ref": "#/$defs/switchSubmission"}, {"$ref": "#/$defs/reviveSubmission"}, {"$ref": "#/$defs/teamSubmission"}]}}}
    },
    {
      "if": {"properties": {"submission_provenance": {"const": "server_default"}}},
      "then": {"properties": {"selected_submission": {"$ref": "#/$defs/defaultSubmission"}}}
    },
    {
      "if": {"properties": {"selected_submission": {"not": {"type": "null"}}}},
      "then": {"properties": {"submission_provenance": {"enum": ["explicit_request", "server_default"]}}}
    },
    {
      "if": {"properties": {"selected_submission": {"type": "null"}}},
      "then": {"properties": {"submission_provenance": {"type": "null"}}}
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "requestIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rqid", "request_digest"],
      "properties": {
        "rqid": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "request_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "submission": {"oneOf": [{"$ref": "#/$defs/moveSubmission"}, {"$ref": "#/$defs/switchSubmission"}, {"$ref": "#/$defs/reviveSubmission"}, {"$ref": "#/$defs/teamSubmission"}, {"$ref": "#/$defs/defaultSubmission"}]},
    "moveSubmission": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "provenance", "slot", "move_id", "terastallize", "team_order"],
      "properties": {"kind": {"const": "move"}, "provenance": {"const": "explicit_request"}, "slot": {"type": "integer", "minimum": 1, "maximum": 4}, "move_id": {"type": "string", "minLength": 1}, "terastallize": {"type": "boolean"}, "team_order": {"type": "array", "maxItems": 0}}
    },
    "switchSubmission": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "provenance", "slot", "move_id", "terastallize", "team_order"],
      "properties": {"kind": {"const": "switch"}, "provenance": {"const": "explicit_request"}, "slot": {"type": "integer", "minimum": 1, "maximum": 6}, "move_id": {"type": "null"}, "terastallize": {"const": false}, "team_order": {"type": "array", "maxItems": 0}}
    },
    "reviveSubmission": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "provenance", "slot", "move_id", "terastallize", "team_order"],
      "properties": {"kind": {"const": "revive"}, "provenance": {"const": "explicit_request"}, "slot": {"type": "integer", "minimum": 1, "maximum": 6}, "move_id": {"type": "null"}, "terastallize": {"const": false}, "team_order": {"type": "array", "maxItems": 0}}
    },
    "teamSubmission": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "provenance", "slot", "move_id", "terastallize", "team_order"],
      "properties": {"kind": {"const": "team"}, "provenance": {"const": "explicit_request"}, "slot": {"type": "null"}, "move_id": {"type": "null"}, "terastallize": {"const": false}, "team_order": {"type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 6}}}
    },
    "defaultSubmission": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "provenance", "slot", "move_id", "terastallize", "team_order"],
      "properties": {"kind": {"const": "default"}, "provenance": {"const": "server_default"}, "slot": {"type": "null"}, "move_id": {"type": "null"}, "terastallize": {"const": false}, "team_order": {"type": "array", "maxItems": 0}}
    },
    "runtimeAndContractDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_digest",
        "contract_set_digest",
        "policy_digest",
        "fallback_and_safety_digest"
      ],
      "properties": {
        "runtime_digest": {"$ref": "#/$defs/digest"},
        "contract_set_digest": {"$ref": "#/$defs/digest"},
        "policy_digest": {"$ref": "#/$defs/digest"},
        "fallback_and_safety_digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
