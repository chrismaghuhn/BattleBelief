{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:battlebelief:schema:documents:contract-snapshot-metadata:v1",
  "title": "BattleBelief contract snapshot metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_id",
    "document_version",
    "source_path",
    "source_digest",
    "snapshot_path",
    "snapshot_digest"
  ],
  "properties": {
    "document_id": {
      "type": "string",
      "minLength": 1
    },
    "document_version": {
      "type": "integer",
      "minimum": 1
    },
    "source_path": {
      "$ref": "#/$defs/repositoryPath"
    },
    "source_digest": {
      "$ref": "#/$defs/digest"
    },
    "snapshot_path": {
      "$ref": "#/$defs/repositoryPath"
    },
    "snapshot_digest": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "repositoryPath": {
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
    }
  }
}
