{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:battlebelief:schema:documents:frontmatter:v1",
  "title": "BattleBelief documentation frontmatter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_id",
    "title",
    "document_type",
    "status",
    "normative",
    "version",
    "applies_to",
    "effective_from",
    "supersedes",
    "superseded_by",
    "owners",
    "last_reviewed"
  ],
  "properties": {
    "document_id": {
      "$ref": "#/$defs/documentId"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "document_type": {
      "enum": [
        "contract",
        "architecture",
        "operation",
        "adr",
        "roadmap",
        "research",
        "audit",
        "archive",
        "guide"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "proposed",
        "accepted",
        "deprecated",
        "superseded",
        "archived"
      ]
    },
    "normative": {
      "type": "boolean"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "applies_to": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "effective_from": {
      "type": "string",
      "format": "date"
    },
    "supersedes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/documentId"
      }
    },
    "superseded_by": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/documentId"
        }
      ]
    },
    "owners": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    }
  },
  "$defs": {
    "documentId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  }
}
