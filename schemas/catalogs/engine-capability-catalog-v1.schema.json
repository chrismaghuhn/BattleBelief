{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:battlebelief:schema:catalog:engine-capability:v1",
  "title": "BattleBelief Gen 9 OU engine capability catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_id", "catalog_version", "generation", "format", "capability_contract_digest", "canonicalization_contract_digest", "definitions"],
  "properties": {
    "schema_version": {"const": 1},
    "catalog_id": {"$ref": "#/$defs/id"},
    "catalog_version": {"type": "string", "minLength": 1},
    "generation": {"const": 9},
    "format": {"const": "gen9ou"},
    "capability_contract_digest": {"$ref": "#/$defs/digest"},
    "canonicalization_contract_digest": {"$ref": "#/$defs/digest"},
    "definitions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/definition"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "capability_id": {"type": "string", "maxLength": 128, "pattern": "^gen9\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*){1,6}$"},
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "description"],
      "properties": {
        "value": {"$ref": "#/$defs/capability_id"},
        "description": {"type": "string", "minLength": 1}
      }
    }
  }
}
