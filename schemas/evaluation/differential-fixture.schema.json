{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:battlebelief:schema:evaluation:differential-fixture:v1",
  "title": "BattleBelief differential fixture v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "corpus_id", "corpus_version", "fixture_id", "fixture_digest", "generation", "format", "ruleset", "seed", "initial_authoritative_full_state", "player_views", "joint_action_intent", "chance_inputs", "capability_ids", "observation_checkpoints", "declared_comparison_fields", "normalization", "classification_policy", "provenance"],
  "properties": {
    "schema_version": {"const": 1},
    "corpus_id": {"$ref": "#/$defs/id"},
    "corpus_version": {"$ref": "#/$defs/version"},
    "fixture_id": {"$ref": "#/$defs/id"},
    "fixture_digest": {"$ref": "#/$defs/digest"},
    "generation": {"const": 9},
    "format": {"const": "gen9ou"},
    "ruleset": {"$ref": "#/$defs/ruleset"},
    "seed": {"$ref": "#/$defs/seed"},
    "initial_authoritative_full_state": {"$ref": "#/$defs/battle_state"},
    "player_views": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/player_view"}},
    "joint_action_intent": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/action_intent"}},
    "chance_inputs": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/chance_input"}},
    "capability_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/capability_id"}},
    "observation_checkpoints": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/checkpoint"}},
    "declared_comparison_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/comparison_field"}},
    "normalization": {"$ref": "#/$defs/normalization"},
    "classification_policy": {"$ref": "#/$defs/classification_policy"},
    "provenance": {"$ref": "#/$defs/provenance"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "version": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "slot_id": {"type": "string", "pattern": "^p[12][a-z][a-z0-9-]*$"},
    "capability_id": {"type": "string", "maxLength": 128, "pattern": "^gen9\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*){2,7}$"},
    "comparison_field": {"enum": ["legal_actions", "active_slot", "effective_types", "terastallized", "hp", "status", "action_order", "terminal_state", "terminal_value", "chance_branch_probabilities"]},
    "type_id": {"enum": ["bug", "dark", "dragon", "electric", "fairy", "fighting", "fire", "flying", "ghost", "grass", "ground", "ice", "normal", "poison", "psychic", "rock", "steel", "water"]},
    "safe_string": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "allOf": [
        {"not": {"pattern": "(?:[A-Za-z]:[\\\\/]|\\\\\\\\|(?<![A-Za-z0-9])/(?:[^\\\\s/]+))"}},
        {"not": {"pattern": "(?i)\\b(?:localhost|(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}|(?:25[0-5]|2[0-4][0-9]|1?[0-9]{1,2})(?:\\.(?:25[0-5]|2[0-4][0-9]|1?[0-9]{1,2})){3})\\b"}},
        {"not": {"pattern": "(?i)\\b[a-z][a-z0-9+.-]*://"}},
        {"not": {"pattern": "(?i)\\b(?:host|hostname)\\s*=\\s*[a-z0-9][a-z0-9-]*"}}
      ]
    },
    "ruleset_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format_id", "ruleset_id", "ruleset_version"],
      "properties": {
        "format_id": {"const": "gen9ou"},
        "ruleset_id": {"$ref": "#/$defs/id"},
        "ruleset_version": {"const": 1}
      }
    },
    "ruleset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleset_id", "ruleset_digest", "snapshot"],
      "properties": {
        "ruleset_id": {"$ref": "#/$defs/id"},
        "ruleset_digest": {"$ref": "#/$defs/digest"},
        "snapshot": {"$ref": "#/$defs/ruleset_snapshot"}
      }
    },
    "seed": {"type": "object", "additionalProperties": false, "required": ["seed_id", "seed_value"], "properties": {"seed_id": {"$ref": "#/$defs/id"}, "seed_value": {"$ref": "#/$defs/safe_string"}}},
    "tera": {"type": "object", "additionalProperties": false, "required": ["active", "type"], "properties": {"active": {"type": "boolean"}, "type": {"$ref": "#/$defs/type_id"}}},
    "hp": {"type": "object", "additionalProperties": false, "required": ["current", "maximum"], "properties": {"current": {"type": "integer", "minimum": 0, "maximum": 999}, "maximum": {"type": "integer", "minimum": 1, "maximum": 999}}},
    "stats": {"type": "object", "additionalProperties": false, "required": ["hp", "atk", "def", "spa", "spd", "spe"], "properties": {"hp": {"type": "integer", "minimum": 1, "maximum": 999}, "atk": {"type": "integer", "minimum": 1, "maximum": 999}, "def": {"type": "integer", "minimum": 1, "maximum": 999}, "spa": {"type": "integer", "minimum": 1, "maximum": 999}, "spd": {"type": "integer", "minimum": 1, "maximum": 999}, "spe": {"type": "integer", "minimum": 1, "maximum": 999}}},
    "boosts": {"type": "object", "additionalProperties": false, "required": ["atk", "def", "spa", "spd", "spe", "accuracy", "evasion"], "properties": {"atk": {"type": "integer", "minimum": -6, "maximum": 6}, "def": {"type": "integer", "minimum": -6, "maximum": 6}, "spa": {"type": "integer", "minimum": -6, "maximum": 6}, "spd": {"type": "integer", "minimum": -6, "maximum": 6}, "spe": {"type": "integer", "minimum": -6, "maximum": 6}, "accuracy": {"type": "integer", "minimum": -6, "maximum": 6}, "evasion": {"type": "integer", "minimum": -6, "maximum": 6}}},
    "pp": {"type": "object", "additionalProperties": false, "required": ["current", "maximum"], "properties": {"current": {"type": "integer", "minimum": 0, "maximum": 64}, "maximum": {"type": "integer", "minimum": 1, "maximum": 64}}},
    "move": {"type": "object", "additionalProperties": false, "required": ["move_id", "pp"], "properties": {"move_id": {"$ref": "#/$defs/id"}, "pp": {"$ref": "#/$defs/pp"}}},
    "combatant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot_id", "species_id", "level", "types", "ability_id", "item_id", "tera", "hp", "status", "stats", "boosts", "moves", "fainted"],
      "properties": {
        "slot_id": {"$ref": "#/$defs/slot_id"}, "species_id": {"$ref": "#/$defs/id"}, "level": {"type": "integer", "minimum": 1, "maximum": 100}, "types": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/type_id"}}, "ability_id": {"$ref": "#/$defs/id"}, "item_id": {"$ref": "#/$defs/id"}, "tera": {"$ref": "#/$defs/tera"}, "hp": {"$ref": "#/$defs/hp"}, "status": {"enum": ["none", "brn", "par", "psn", "tox", "slp", "frz"]}, "stats": {"$ref": "#/$defs/stats"}, "boosts": {"$ref": "#/$defs/boosts"}, "moves": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/move"}}, "fainted": {"type": "boolean"}
      }
    },
    "player_state": {"type": "object", "additionalProperties": false, "required": ["active_slot", "team"], "properties": {"active_slot": {"$ref": "#/$defs/slot_id"}, "team": {"type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true, "items": {"$ref": "#/$defs/combatant"}}}},
    "battle_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "players", "terminal"],
      "properties": {
        "field": {"type": "object", "additionalProperties": false, "required": ["terrain", "turn", "weather"], "properties": {"terrain": {"enum": ["none", "electric", "grassy", "misty", "psychic"]}, "turn": {"type": "integer", "minimum": 1, "maximum": 1000}, "weather": {"enum": ["none", "rain", "sand", "snow", "sun"]}}},
        "players": {"type": "object", "additionalProperties": false, "required": ["p1", "p2"], "properties": {"p1": {"$ref": "#/$defs/player_state"}, "p2": {"$ref": "#/$defs/player_state"}}},
        "terminal": {"type": "object", "additionalProperties": false, "required": ["state", "value"], "properties": {"state": {"enum": ["ongoing", "p1-win", "p2-win", "tie"]}, "value": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": -1, "maximum": 1}]}}}
      }
    },
    "public_combatant": {"type": "object", "additionalProperties": false, "required": ["slot_id", "species_id", "types", "hp", "status", "terastallized", "fainted"], "properties": {"slot_id": {"$ref": "#/$defs/slot_id"}, "species_id": {"$ref": "#/$defs/id"}, "types": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/type_id"}}, "hp": {"$ref": "#/$defs/hp"}, "status": {"enum": ["none", "brn", "par", "psn", "tox", "slp", "frz"]}, "terastallized": {"type": "boolean"}, "fainted": {"type": "boolean"}}},
    "action": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "move_id"], "properties": {"kind": {"const": "move"}, "move_id": {"$ref": "#/$defs/id"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "target_slot"], "properties": {"kind": {"const": "switch"}, "target_slot": {"$ref": "#/$defs/slot_id"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "move_id"], "properties": {"kind": {"const": "tera"}, "move_id": {"$ref": "#/$defs/id"}}}
      ]
    },
    "player_view": {"type": "object", "additionalProperties": false, "required": ["player_id", "view"], "properties": {"player_id": {"enum": ["p1", "p2"]}, "view": {"type": "object", "additionalProperties": false, "required": ["own_active_slot", "opponent_active_slot", "own_active", "opponent_active", "legal_actions", "tera_available"], "properties": {"own_active_slot": {"$ref": "#/$defs/slot_id"}, "opponent_active_slot": {"$ref": "#/$defs/slot_id"}, "own_active": {"$ref": "#/$defs/public_combatant"}, "opponent_active": {"$ref": "#/$defs/public_combatant"}, "legal_actions": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/action"}}, "tera_available": {"type": "boolean"}}}}},
    "action_intent": {"type": "object", "additionalProperties": false, "required": ["actor", "action"], "properties": {"actor": {"enum": ["p1", "p2"]}, "action": {"$ref": "#/$defs/action"}}},
    "chance_outcome": {"type": "object", "additionalProperties": false, "required": ["outcome_id", "numerator", "denominator"], "properties": {"outcome_id": {"$ref": "#/$defs/id"}, "numerator": {"type": "integer", "minimum": 0, "maximum": 1000}, "denominator": {"type": "integer", "minimum": 1, "maximum": 1000}}},
    "chance_input": {"type": "object", "additionalProperties": false, "required": ["chance_id", "kind", "seed_value", "outcomes"], "properties": {"chance_id": {"$ref": "#/$defs/id"}, "kind": {"enum": ["damage-roll", "speed-tie"]}, "seed_value": {"$ref": "#/$defs/safe_string"}, "outcomes": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/chance_outcome"}}}},
    "checkpoint": {"type": "object", "additionalProperties": false, "required": ["checkpoint_id", "comparison_fields"], "properties": {"checkpoint_id": {"$ref": "#/$defs/id"}, "comparison_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/comparison_field"}}}},
    "normalization": {"type": "object", "additionalProperties": false, "required": ["profile_id", "profile_version", "profile_digest"], "properties": {"profile_id": {"$ref": "#/$defs/id"}, "profile_version": {"$ref": "#/$defs/version"}, "profile_digest": {"$ref": "#/$defs/digest"}}},
    "classification_policy": {"type": "object", "additionalProperties": false, "required": ["classifier_id", "classifier_version", "classifier_source_digest", "known_divergence_id"], "properties": {"classifier_id": {"$ref": "#/$defs/id"}, "classifier_version": {"$ref": "#/$defs/version"}, "classifier_source_digest": {"$ref": "#/$defs/digest"}, "known_divergence_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["source_type", "source_id", "license_id", "reviewed"], "properties": {"source_type": {"enum": ["project-authored", "licensed-reviewed"]}, "source_id": {"$ref": "#/$defs/id"}, "license_id": {"$ref": "#/$defs/safe_string"}, "reviewed": {"const": true}}}
  }
}
