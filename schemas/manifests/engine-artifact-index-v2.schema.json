{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:battlebelief:schema:manifest:engine-artifact-index:v2",
  "title": "BattleBelief downstream-patched poke-engine artifact index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "schema_id", "manifest_id", "source_schema_id", "build_schema_id", "source_manifest_digest", "source_tree_digest", "downstream_patch_digest", "repository_url", "release_tag", "release_prerelease", "release_assets_immutable", "cells", "canonicalization_profile"],
  "properties": {
    "schema_version": { "const": 2 },
    "schema_id": { "const": "urn:battlebelief:schema:manifest:engine-artifact-index:v2" },
    "manifest_id": { "const": "poke-engine-artifact-index-v2-legal-choices" },
    "source_schema_id": { "const": "urn:battlebelief:schema:manifest:engine-source:v2" },
    "build_schema_id": { "const": "urn:battlebelief:schema:manifest:engine-build:v2" },
    "source_manifest_digest": { "$ref": "#/$defs/sha256" },
    "source_tree_digest": { "$ref": "#/$defs/sha256" },
    "downstream_patch_digest": { "$ref": "#/$defs/sha256" },
    "repository_url": { "const": "https://github.com/chrismaghuhn/BattleBelief" },
    "release_tag": { "const": "engine-poke-engine-v0.0.49-bcf13823-v2-legal-choices-r1" },
    "release_prerelease": { "const": true },
    "release_assets_immutable": { "const": true },
    "cells": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/cell" }
    },
    "canonicalization_profile": { "const": "rfc8785-jcs-v1" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cell_id", "source_manifest_digest", "build_manifest_digest", "wheel_filename", "wheel_size", "wheel_sha256", "distribution_name", "distribution_version", "python_tag", "abi_tag", "platform_tag", "operating_system", "architecture", "features", "adapter_version", "release_tag", "release_asset_url", "sentinel_fixture_digest", "sentinel_result_digest", "sentinel_configuration_digest", "availability_status"],
      "properties": {
        "cell_id": { "type": "string", "pattern": "^(?:ubuntu-24\\.04|windows-2025)-x86_64-cp(?:312|313|314)$" },
        "source_manifest_digest": { "$ref": "#/$defs/sha256" },
        "build_manifest_digest": { "$ref": "#/$defs/sha256" },
        "wheel_filename": { "type": "string", "pattern": "^poke_engine-0\\.0\\.49-(?:cp(?:312|313|314)-cp(?:312|313|314)-linux_x86_64|cp(?:312|313|314)-none-win_amd64)\\.whl$" },
        "wheel_size": { "type": "integer", "minimum": 1 },
        "wheel_sha256": { "$ref": "#/$defs/sha256" },
        "distribution_name": { "const": "poke-engine" },
        "distribution_version": { "const": "0.0.49" },
        "python_tag": { "enum": ["cp312", "cp313", "cp314"] },
        "abi_tag": { "enum": ["cp312", "cp313", "cp314", "none"] },
        "platform_tag": { "enum": ["linux_x86_64", "win_amd64"] },
        "operating_system": { "enum": ["ubuntu-24.04", "windows-2025"] },
        "architecture": { "const": "x86_64" },
        "features": { "const": ["poke-engine/gen9", "poke-engine/terastallization"] },
        "adapter_version": { "const": "battlebelief-poke-engine-v2-legal-choices" },
        "release_tag": { "const": "engine-poke-engine-v0.0.49-bcf13823-v2-legal-choices-r1" },
        "release_asset_url": { "type": "string", "format": "uri", "pattern": "^https://github\\.com/chrismaghuhn/BattleBelief/releases/download/engine-poke-engine-v0\\.0\\.49-bcf13823-v2-legal-choices/[A-Za-z0-9._-]+\\.whl$" },
        "sentinel_fixture_digest": { "$ref": "#/$defs/sha256" },
        "sentinel_result_digest": { "$ref": "#/$defs/sha256" },
        "sentinel_configuration_digest": { "$ref": "#/$defs/sha256" },
        "availability_status": { "enum": ["candidate", "available"] }
      }
    }
  }
}
