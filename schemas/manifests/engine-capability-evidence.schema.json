{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:battlebelief:schema:manifest:engine-capability-evidence:v1",
  "title": "BattleBelief engine capability evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_id", "catalog_id", "catalog_version", "catalog_digest", "capability_id", "environment_cell_id", "engine_source_manifest_digest", "engine_build_manifest_digest", "artifact_index_digest", "wheel_digest", "transition_adapter_id", "transition_adapter_version", "transition_adapter_source_digest", "transition_model_contract_digest", "transition_adapter_conformance_digest", "oracle_source_manifest_digest", "oracle_build_manifest_digest", "ruleset_digest", "corpus_digest", "runner_source_digest", "classifier_source_digest", "qualification_result_schema_id", "qualification_result_digest", "canonicalization_contract_digest"],
  "properties": {
    "schema_version": {"const": 1}, "evidence_id": {"$ref": "#/$defs/id"}, "catalog_id": {"$ref": "#/$defs/id"}, "catalog_version": {"type": "string", "minLength": 1}, "catalog_digest": {"$ref": "#/$defs/digest"}, "capability_id": {"$ref": "#/$defs/capability_id"}, "environment_cell_id": {"$ref": "#/$defs/environment_cell_id"},
    "engine_source_manifest_digest": {"$ref": "#/$defs/digest"}, "engine_build_manifest_digest": {"$ref": "#/$defs/digest"}, "artifact_index_digest": {"$ref": "#/$defs/digest"}, "wheel_digest": {"$ref": "#/$defs/digest"},
    "transition_adapter_id": {"$ref": "#/$defs/id"}, "transition_adapter_version": {"type": "string", "minLength": 1}, "transition_adapter_source_digest": {"$ref": "#/$defs/digest"}, "transition_model_contract_digest": {"$ref": "#/$defs/digest"}, "transition_adapter_conformance_digest": {"$ref": "#/$defs/digest"},
    "oracle_source_manifest_digest": {"$ref": "#/$defs/digest"}, "oracle_build_manifest_digest": {"$ref": "#/$defs/digest"}, "ruleset_digest": {"$ref": "#/$defs/digest"}, "corpus_digest": {"$ref": "#/$defs/digest"}, "runner_source_digest": {"$ref": "#/$defs/digest"}, "classifier_source_digest": {"$ref": "#/$defs/digest"},
    "qualification_result_schema_id": {"$ref": "#/$defs/schema_id"}, "qualification_result_digest": {"$ref": "#/$defs/digest"}, "canonicalization_contract_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"}, "environment_cell_id": {"type": "string", "pattern": "^[a-z0-9]+(?:[-._][a-z0-9]+)*$"}, "schema_id": {"type": "string", "pattern": "^urn:battlebelief:schema:[a-z][a-z0-9-]*(?::[a-z][a-z0-9-]*)*:v[1-9][0-9]*$"}, "capability_id": {"type": "string", "maxLength": 128, "pattern": "^gen9\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*){1,6}$"}
  }
}
