{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:battlebelief:schema:manifest:calibration-state-manifest:v2",
  "title": "M1.5 executable calibration state manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "rule_id", "construction", "states"],
  "properties": {
    "schema_version": {"const": 2}, "manifest_id": {"const": "m15-synthetic-calibration-states-v2"}, "rule_id": {"const": "m15-synthetic-calibration-state-v2"},
    "construction": {"type": "object", "additionalProperties": false, "required": ["algorithm_id", "field_order", "enumeration_order", "public_fields_only", "declared_domains", "state_set"], "properties": {"algorithm_id": {"const": "public-observation-grid-v2"}, "field_order": {"const": ["turn_index", "active_slot_count", "request_kind", "weather_class"]}, "enumeration_order": {"const": "lexicographic_over_declared_domains"}, "public_fields_only": {"const": true}, "declared_domains": {"type": "object", "additionalProperties": false, "required": ["turn_index", "active_slot_count", "request_kind", "weather_class"], "properties": {"turn_index": {"const": [0, 1, 2]}, "active_slot_count": {"const": [1, 2]}, "request_kind": {"const": ["move", "switch"]}, "weather_class": {"const": ["none", "sun"]}}}, "state_set": {"const": "explicit_public_executable_inputs_v1"}}},
    "states": {"type": "array", "minItems": 24, "items": {"$ref": "#/$defs/state"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "identity": {"type": "object", "additionalProperties": false, "required": ["rqid", "request_digest"], "properties": {"rqid": {"type": "integer", "minimum": 0}, "request_digest": {"$ref": "#/$defs/digest"}}},
    "submission": {"type": "object", "additionalProperties": false, "required": ["kind", "provenance", "slot", "move_id", "terastallize", "team_order"], "properties": {"kind": {"enum": ["move", "switch"]}, "provenance": {"const": "explicit_request"}, "slot": {"type": "integer", "minimum": 1, "maximum": 6}, "move_id": {"type": ["string", "null"], "pattern": "^[a-z0-9]{1,100}$"}, "terastallize": {"const": false}, "team_order": {"const": []}}},
    "observedState": {"type": "object", "additionalProperties": false, "required": ["event_index", "turn", "battle_started", "our_side", "weather", "rules", "field_conditions", "p1", "p2", "visible_evidence", "ignored_display_count"], "properties": {"event_index": {"type": "integer", "minimum": 0}, "turn": {"type": "integer", "minimum": 0}, "battle_started": {"const": true}, "our_side": {"const": "p1"}, "weather": {"enum": ["none", "sun"]}, "rules": {"const": ["gen9ou"]}, "field_conditions": {"const": []}, "p1": {"$ref": "#/$defs/side"}, "p2": {"$ref": "#/$defs/side"}, "visible_evidence": {"const": []}, "ignored_display_count": {"const": 0}}},
    "side": {"type": "object", "additionalProperties": false, "required": ["side_id", "team_size", "active_slot", "pokemon"], "properties": {"side_id": {"enum": ["p1", "p2"]}, "team_size": {"const": 6}, "active_slot": {"const": 1}, "pokemon": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/pokemon"}}}},
    "pokemon": {"type": "object", "additionalProperties": false, "required": ["slot", "details", "active", "hp", "revealed_moves"], "properties": {"slot": {"const": 1}, "details": {"type": "string", "minLength": 1}, "active": {"const": true}, "hp": {"type": "object", "additionalProperties": false, "required": ["current", "maximum", "precision", "fainted"], "properties": {"current": {"const": 100}, "maximum": {"const": 100}, "precision": {"const": "exact"}, "fainted": {"const": false}}}, "revealed_moves": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9]+$"}}}},
    "state": {"type": "object", "additionalProperties": false, "required": ["state_id", "public_state", "public_observed_state", "decision_request", "safe_submission_set", "inputs_digest"], "properties": {"state_id": {"$ref": "#/$defs/digest"}, "public_state": {"type": "object", "additionalProperties": false, "required": ["turn_index", "active_slot_count", "request_kind", "weather_class"], "properties": {"turn_index": {"type": "integer", "minimum": 0}, "active_slot_count": {"type": "integer", "minimum": 1, "maximum": 2}, "request_kind": {"enum": ["move", "switch"]}, "weather_class": {"enum": ["none", "sun"]}}}, "public_observed_state": {"$ref": "#/$defs/observedState"}, "decision_request": {"type": "object", "additionalProperties": false, "required": ["identity", "kind", "side_id", "team_member_count", "active_identity", "is_update"], "properties": {"identity": {"$ref": "#/$defs/identity"}, "kind": {"enum": ["move", "forced_switch"]}, "side_id": {"const": "p1"}, "team_member_count": {"const": 6}, "active_identity": {"const": "fixture-p1-slot-1"}, "is_update": {"const": false}}}, "safe_submission_set": {"type": "object", "additionalProperties": false, "required": ["request_identity", "submissions"], "properties": {"request_identity": {"$ref": "#/$defs/identity"}, "submissions": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/submission"}}}}, "inputs_digest": {"$ref": "#/$defs/digest"}}}
  }
}
