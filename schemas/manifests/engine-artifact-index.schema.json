{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:battlebelief:schema:manifest:engine-artifact-index:v1",
  "title": "BattleBelief poke-engine artifact index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_id",
    "manifest_id",
    "source_schema_id",
    "build_schema_id",
    "source_manifest_digest",
    "repository_url",
    "release_tag",
    "release_prerelease",
    "release_assets_immutable",
    "cells",
    "canonicalization_profile"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "schema_id": { "const": "urn:battlebelief:schema:manifest:engine-artifact-index:v1" },
    "manifest_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
    "source_schema_id": { "const": "urn:battlebelief:schema:manifest:engine-source:v1" },
    "build_schema_id": { "const": "urn:battlebelief:schema:manifest:engine-build:v1" },
    "source_manifest_digest": { "$ref": "#/$defs/sha256" },
    "repository_url": { "const": "https://github.com/chrismaghuhn/BattleBelief" },
    "release_tag": { "const": "engine-poke-engine-v0.0.48-bcf13823-v1" },
    "release_prerelease": { "const": true },
    "release_assets_immutable": { "const": true },
    "cells": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/cell" },
      "allOf": [
        { "contains": { "type": "object", "required": ["cell_id"], "properties": { "cell_id": { "const": "ubuntu-24.04-x86_64-cp312" } } }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "required": ["cell_id"], "properties": { "cell_id": { "const": "ubuntu-24.04-x86_64-cp313" } } }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "required": ["cell_id"], "properties": { "cell_id": { "const": "ubuntu-24.04-x86_64-cp314" } } }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "required": ["cell_id"], "properties": { "cell_id": { "const": "windows-2025-x86_64-cp312" } } }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "required": ["cell_id"], "properties": { "cell_id": { "const": "windows-2025-x86_64-cp313" } } }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "required": ["cell_id"], "properties": { "cell_id": { "const": "windows-2025-x86_64-cp314" } } }, "minContains": 1, "maxContains": 1 }
      ]
    },
    "canonicalization_profile": { "const": "rfc8785-jcs-v1" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cell_id",
        "source_manifest_digest",
        "build_manifest_digest",
        "wheel_filename",
        "wheel_size",
        "wheel_sha256",
        "distribution_name",
        "distribution_version",
        "python_tag",
        "abi_tag",
        "platform_tag",
        "operating_system",
        "architecture",
        "features",
        "adapter_version",
        "release_tag",
        "release_asset_url",
        "sentinel_fixture_digest",
        "sentinel_result_digest",
        "sentinel_configuration_digest",
        "availability_status"
      ],
      "properties": {
        "cell_id": { "type": "string", "pattern": "^(?:ubuntu-24\\.04|windows-2025)-x86_64-cp(?:312|313|314)$" },
        "source_manifest_digest": { "$ref": "#/$defs/sha256" },
        "build_manifest_digest": { "$ref": "#/$defs/sha256" },
        "wheel_filename": { "type": "string", "pattern": "^poke_engine-0\\.0\\.48-cp(?:312|313|314)-cp(?:312|313|314)-(?:linux_x86_64|win_amd64)\\.whl$" },
        "wheel_size": { "type": "integer", "minimum": 1 },
        "wheel_sha256": { "$ref": "#/$defs/sha256" },
        "distribution_name": { "const": "poke-engine" },
        "distribution_version": { "const": "0.0.48" },
        "python_tag": { "enum": ["cp312", "cp313", "cp314"] },
        "abi_tag": { "enum": ["cp312", "cp313", "cp314"] },
        "platform_tag": { "enum": ["linux_x86_64", "win_amd64"] },
        "operating_system": { "enum": ["ubuntu-24.04", "windows-2025"] },
        "architecture": { "const": "x86_64" },
        "features": { "type": "array", "const": ["poke-engine/gen9", "poke-engine/terastallization"] },
        "adapter_version": { "const": "battlebelief-poke-engine-v1" },
        "release_tag": { "const": "engine-poke-engine-v0.0.48-bcf13823-v1" },
        "release_asset_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/chrismaghuhn/BattleBelief/releases/download/engine-poke-engine-v0\\.0\\.48-bcf13823-v1/[A-Za-z0-9._-]+\\.whl$"
        },
        "sentinel_fixture_digest": { "$ref": "#/$defs/sha256" },
        "sentinel_result_digest": { "$ref": "#/$defs/sha256" },
        "sentinel_configuration_digest": { "$ref": "#/$defs/sha256" },
        "availability_status": { "const": "available" }
      }
    }
  }
}
