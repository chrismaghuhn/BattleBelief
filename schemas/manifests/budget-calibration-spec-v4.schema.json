{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:battlebelief:schema:manifest:budget-calibration-spec:v4",
  "title": "Budget calibration specification v4",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "spec_id", "budget_mode", "calibrated_parameter", "world_sampling_count", "total_work_formula", "reference_environment_specification", "calibration_state_rule_id", "calibration_state_manifest_digest", "ordered_work_grid", "selection_rule_id", "measurement_profile_id", "selection_measurement_id", "required_measurement_ids", "runtime_limits_ms", "allowed_runtime_measurements", "forbidden_quality_measurements"],
  "properties": {
    "schema_version": {"const": 4}, "spec_id": {"type": "string", "minLength": 1}, "budget_mode": {"const": "calibrated_grid"}, "calibrated_parameter": {"const": "per_world_work"}, "world_sampling_count": {"const": 16}, "total_work_formula": {"const": "world_sampling_count_times_per_world_work"}, "reference_environment_specification": {"type": "object", "additionalProperties": false, "required": ["python", "platform", "runtime_profile"], "properties": {"python": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"}, "platform": {"type": "string", "minLength": 1}, "runtime_profile": {"const": "offline_m15_calibration"}}}, "calibration_state_rule_id": {"const": "m15-synthetic-calibration-state-v2"}, "calibration_state_manifest_digest": {"$ref": "#/$defs/digest"}, "ordered_work_grid": {"const": [64, 128, 256, 512]}, "selection_rule_id": {"const": "largest-value-under-runtime-limit-v1"}, "measurement_profile_id": {"type": "string", "minLength": 1}, "selection_measurement_id": {"const": "wall_time_ms"}, "required_measurement_ids": {"const": ["wall_time_ms", "cpu_time_ms"]}, "runtime_limits_ms": {"type": "object", "additionalProperties": false, "required": ["wall_time_ms", "cpu_time_ms"], "properties": {"wall_time_ms": {"const": 2000}, "cpu_time_ms": {"const": 2000}}}, "allowed_runtime_measurements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "forbidden_quality_measurements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
