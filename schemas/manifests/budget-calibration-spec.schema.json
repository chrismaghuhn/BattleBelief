{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:battlebelief:schema:manifest:budget-calibration-spec:v2",
  "title": "Budget calibration specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "spec_id", "budget_mode", "reference_environment_specification", "calibration_state_construction_rule", "ordered_work_grid", "selection_rule_id", "measurement_profile_id", "selection_measurement_id", "required_measurement_ids", "runtime_limit_ms", "allowed_runtime_measurements", "forbidden_quality_measurements"],
  "properties": {
    "schema_version": {"const": 2},
    "spec_id": {"type": "string", "minLength": 1},
    "budget_mode": {"enum": ["calibrated_grid", "hardware_normalized"]},
    "reference_environment_specification": {"type": "object", "minProperties": 1},
    "calibration_state_construction_rule": {"type": "string", "minLength": 1},
    "ordered_work_grid": {"type": "array", "items": {"type": "integer", "minimum": 1}, "minItems": 1, "uniqueItems": true},
    "selection_rule_id": {"type": "string", "minLength": 1},
    "measurement_profile_id": {"type": "string", "minLength": 1},
    "selection_measurement_id": {"type": "string", "minLength": 1},
    "required_measurement_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "runtime_limit_ms": {"type": "number", "exclusiveMinimum": 0},
    "allowed_runtime_measurements": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "forbidden_quality_measurements": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}
  }
}
