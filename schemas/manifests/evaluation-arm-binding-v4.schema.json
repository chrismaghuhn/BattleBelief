{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:battlebelief:schema:manifest:evaluation-arm-binding:v4",
  "title": "BattleBelief arm implementation binding v4",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "binding_id", "binding_kind", "artifact_version", "supersedes_digest", "registration_id", "registration_digest", "arm_id", "source_commit", "source_manifest", "package_or_wheel_source_manifest", "package_or_wheel_digest", "runtime_source_manifest", "runtime_digest", "components", "decision_record_schema_digest", "canonicalizer_digest", "contract_set", "contract_set_digest"],
  "properties": {
    "schema_version": {"const": 4},
    "binding_id": {"type": "string", "minLength": 1},
    "binding_kind": {"const": "implementation"},
    "artifact_version": {"type": "integer", "minimum": 1},
    "supersedes_digest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "registration_id": {"type": "string", "minLength": 1},
    "registration_digest": {"$ref": "#/$defs/digest"},
    "arm_id": {"type": "string", "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_manifest": {"$ref": "#/$defs/fileManifest"},
    "package_or_wheel_source_manifest": {"$ref": "#/$defs/fileManifest"},
    "package_or_wheel_digest": {"$ref": "#/$defs/digest"},
    "runtime_source_manifest": {"$ref": "#/$defs/fileManifest"},
    "runtime_digest": {"$ref": "#/$defs/digest"},
    "components": {"$ref": "#/$defs/components"},
    "decision_record_schema_digest": {"$ref": "#/$defs/digest"},
    "canonicalizer_digest": {"$ref": "#/$defs/digest"},
    "contract_set": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["document_id", "document_version", "document_digest"], "properties": {"document_id": {"type": "string", "minLength": 1}, "document_version": {"type": "integer", "minimum": 1}, "document_digest": {"$ref": "#/$defs/digest"}}}},
    "contract_set_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "fileManifest": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["repository_path", "content_digest"], "properties": {"repository_path": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.)(?![A-Za-z]:).+$"}, "content_digest": {"$ref": "#/$defs/digest"}}}},
    "component": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["state", "digest", "source_manifest"], "properties": {"state": {"const": "bound"}, "digest": {"$ref": "#/$defs/digest"}, "source_manifest": {"$ref": "#/$defs/fileManifest"}}}, {"type": "object", "additionalProperties": false, "required": ["state"], "properties": {"state": {"enum": ["not_applicable", "unbound"]}}}]},
    "components": {"type": "object", "additionalProperties": false, "required": ["policy", "fallback_and_safety", "search_algorithm", "engine", "prior", "belief", "model"], "properties": {"policy": {"$ref": "#/$defs/component"}, "fallback_and_safety": {"$ref": "#/$defs/component"}, "search_algorithm": {"$ref": "#/$defs/component"}, "engine": {"$ref": "#/$defs/component"}, "prior": {"$ref": "#/$defs/component"}, "belief": {"$ref": "#/$defs/component"}, "model": {"$ref": "#/$defs/component"}}}
  }
}
