{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:battlebelief:schema:manifest:search-execution-spec:v4",
  "title": "Declarative determinization search execution specification v4",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "spec_id", "registration_id", "arm_id", "algorithm_version", "world_sampling", "lookahead", "budget_parameter", "value_aggregation", "action_aggregation", "tie_break", "budget_consumption", "fallback_arm_id", "calibration_state_rule_id", "research_reference"],
  "properties": {
    "schema_version": {"const": 4},
    "spec_id": {"type": "string", "minLength": 1},
    "registration_id": {"const": "m15-core-comparisons-v1"},
    "arm_id": {"const": "determinization_search_v0"},
    "algorithm_version": {"type": "string", "minLength": 1},
    "world_sampling": {"type": "object", "additionalProperties": false, "required": ["count", "distribution"], "properties": {"count": {"const": 16}, "distribution": {"type": "string", "minLength": 1}}},
    "lookahead": {"type": "object", "additionalProperties": false, "required": ["depth"], "properties": {"depth": {"type": "integer", "minimum": 1}}},
    "budget_parameter": {"type": "object", "additionalProperties": false, "required": ["parameter_id", "work_unit", "ordered_work_grid", "total_work_formula", "calibration_spec_digest"], "properties": {"parameter_id": {"const": "per_world_work"}, "work_unit": {"const": "search_work_units"}, "ordered_work_grid": {"const": [64, 128, 256, 512]}, "total_work_formula": {"const": "world_sampling_count_times_per_world_work"}, "calibration_spec_digest": {"$ref": "#/$defs/digest"}}},
    "value_aggregation": {"type": "string", "minLength": 1},
    "action_aggregation": {"type": "string", "minLength": 1},
    "tie_break": {"type": "string", "minLength": 1},
    "budget_consumption": {"type": "string", "minLength": 1},
    "fallback_arm_id": {"const": "heuristic_v0"},
    "calibration_state_rule_id": {"const": "m15-synthetic-calibration-state-v2"},
    "research_reference": {"type": "object", "additionalProperties": false, "required": ["document_id", "document_version", "document_digest"], "properties": {"document_id": {"const": "roadmap-research-strategy-and-experiments"}, "document_version": {"type": "integer", "minimum": 1}, "document_digest": {"$ref": "#/$defs/digest"}}}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
