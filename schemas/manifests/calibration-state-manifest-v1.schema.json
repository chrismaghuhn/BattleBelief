{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:battlebelief:schema:manifest:calibration-state-manifest:v1",
  "title": "M1.5 calibration state manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "rule_id", "construction", "states"],
  "properties": {
    "schema_version": {"const": 1},
    "manifest_id": {"const": "m15-synthetic-calibration-states-v1"},
    "rule_id": {"const": "m15-synthetic-calibration-state-v1"},
    "construction": {"type": "object", "additionalProperties": false, "required": ["algorithm_id", "field_order", "enumeration_order", "public_fields_only", "declared_domains", "state_set"], "properties": {"algorithm_id": {"const": "public-observation-grid-v1"}, "field_order": {"const": ["turn_index", "active_slot_count", "request_kind", "weather_class"]}, "enumeration_order": {"const": "lexicographic_over_declared_domains"}, "public_fields_only": {"const": true}, "declared_domains": {"type": "object", "additionalProperties": false, "required": ["turn_index", "active_slot_count", "request_kind", "weather_class"], "properties": {"turn_index": {"const": [0, 1, 2]}, "active_slot_count": {"const": [1, 2]}, "request_kind": {"const": ["move", "switch"]}, "weather_class": {"const": ["none", "sun"]}}}, "state_set": {"const": "explicit_public_states_v1"}}},
    "states": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["state_id", "public_state"], "properties": {"state_id": {"$ref": "#/$defs/digest"}, "public_state": {"type": "object", "additionalProperties": false, "required": ["turn_index", "active_slot_count", "request_kind", "weather_class"], "properties": {"turn_index": {"type": "integer", "minimum": 0}, "active_slot_count": {"type": "integer", "minimum": 0, "maximum": 6}, "request_kind": {"enum": ["move", "switch"]}, "weather_class": {"enum": ["none", "sun"]}}}}}}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
