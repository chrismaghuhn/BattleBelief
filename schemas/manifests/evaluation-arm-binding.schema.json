{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:battlebelief:schema:manifest:evaluation-arm-binding:v2",
  "title": "BattleBelief arm implementation binding",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "binding_id", "binding_kind", "artifact_version", "supersedes_digest", "registration_id", "registration_digest", "arm_id", "source_commit", "package_or_wheel_digest", "components", "decision_record_schema_digest", "canonicalizer_digest", "contract_set_digest"],
  "properties": {
    "schema_version": {"const": 2},
    "binding_id": {"type": "string", "minLength": 1},
    "binding_kind": {"const": "implementation"},
    "artifact_version": {"type": "integer", "minimum": 1},
    "supersedes_digest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "registration_id": {"type": "string", "minLength": 1},
    "registration_digest": {"$ref": "#/$defs/digest"},
    "arm_id": {"type": "string", "minLength": 1},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "package_or_wheel_digest": {"$ref": "#/$defs/digest"},
    "components": {"$ref": "#/$defs/components"},
    "decision_record_schema_digest": {"$ref": "#/$defs/digest"},
    "canonicalizer_digest": {"$ref": "#/$defs/digest"},
    "contract_set_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "component": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "digest"],
          "properties": {
            "state": {"const": "bound"},
            "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state"],
          "properties": {"state": {"enum": ["not_applicable", "unbound"]}}
        }
      ]
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "fallback_and_safety", "search_algorithm", "engine", "prior", "belief", "model"],
      "properties": {
        "policy": {"$ref": "#/$defs/component"},
        "fallback_and_safety": {"$ref": "#/$defs/component"},
        "search_algorithm": {"$ref": "#/$defs/component"},
        "engine": {"$ref": "#/$defs/component"},
        "prior": {"$ref": "#/$defs/component"},
        "belief": {"$ref": "#/$defs/component"},
        "model": {"$ref": "#/$defs/component"}
      }
    }
  }
}
