{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:battlebelief:manifest:budget-calibration-evidence:1",
  "title": "Budget calibration evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_id", "calibration_spec_digest", "actual_environment_digest", "actual_calibration_state_digest", "runtime_measurements", "selected_work_value"],
  "properties": {
    "schema_version": {"const": 1},
    "evidence_id": {"type": "string", "minLength": 1},
    "calibration_spec_digest": {"$ref": "#/$defs/digest"},
    "actual_environment_digest": {"$ref": "#/$defs/digest"},
    "actual_calibration_state_digest": {"$ref": "#/$defs/digest"},
    "runtime_measurements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["work_value", "runtime_ms"],
        "properties": {
          "work_value": {"type": "integer", "minimum": 1},
          "runtime_ms": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    },
    "selected_work_value": {"type": "integer", "minimum": 1}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
