{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:battlebelief:schema:manifest:experiment-registration:v4",
  "title": "BattleBelief experiment registration v4",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_version", "supersedes_digest", "registration_id", "registration_status", "hypothesis", "null_hypotheses", "arms", "comparisons", "metric_references", "estimand_references", "analysis_procedure_references", "contract_references", "pool_access", "pool_rules", "budget_profiles", "decision_gates"],
  "properties": {
    "schema_version": {"const": 4},
    "artifact_version": {"type": "integer", "minimum": 1},
    "supersedes_digest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "registration_id": {"type": "string", "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"},
    "registration_status": {"const": "frozen"},
    "hypothesis": {"type": "string", "minLength": 1},
    "null_hypotheses": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "arms": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["arm_id", "policy_kind", "search_algorithm_id", "world_distribution_or_belief_mode", "lifecycle"], "properties": {"arm_id": {"type": "string", "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"}, "policy_kind": {"enum": ["heuristic", "search", "model_or_hybrid"]}, "search_algorithm_id": {"type": ["string", "null"]}, "world_distribution_or_belief_mode": {"type": "string", "minLength": 1}, "lifecycle": {"enum": ["active", "deferred", "disabled"]}, "execution_spec_digest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}}}},
    "comparisons": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["comparison_id", "left_arm_id", "right_arm_id", "primary_metric_id", "estimand_id", "analysis_procedure_id", "direction", "confidence_level", "confidence_sidedness", "technical_outcome_treatment_id", "minimum_effect", "tie_break_metric_id", "tie_break_direction"], "properties": {"comparison_id": {"type": "string", "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"}, "left_arm_id": {"type": "string"}, "right_arm_id": {"type": "string"}, "primary_metric_id": {"type": "string", "minLength": 1}, "estimand_id": {"type": "string", "minLength": 1}, "analysis_procedure_id": {"type": "string", "minLength": 1}, "direction": {"const": "higher_is_better"}, "confidence_level": {"const": 0.95}, "confidence_sidedness": {"const": "one_sided"}, "technical_outcome_treatment_id": {"type": "string", "minLength": 1}, "minimum_effect": {"const": 0.05}, "tie_break_metric_id": {"const": "end_to_end_latency_ms_v1"}, "tie_break_direction": {"const": "lower_is_better"}}}},
    "metric_references": {"type": "array", "minItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["document_id", "document_version", "document_digest", "metric_id", "role"], "properties": {"document_id": {"const": "evaluation-metrics"}, "document_version": {"type": "integer", "minimum": 1}, "document_digest": {"$ref": "#/$defs/digest"}, "metric_id": {"type": "string", "minLength": 1}, "role": {"enum": ["primary", "secondary", "diagnostic"]}}}},
    "estimand_references": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["document_id", "document_version", "document_digest", "estimand_id"], "properties": {"document_id": {"const": "evaluation-statistical-analysis"}, "document_version": {"type": "integer", "minimum": 1}, "document_digest": {"$ref": "#/$defs/digest"}, "estimand_id": {"type": "string", "minLength": 1}}}},
    "analysis_procedure_references": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["document_id", "document_version", "document_digest", "analysis_procedure_id"], "properties": {"document_id": {"const": "evaluation-statistical-analysis"}, "document_version": {"type": "integer", "minimum": 1}, "document_digest": {"$ref": "#/$defs/digest"}, "analysis_procedure_id": {"type": "string", "minLength": 1}}}},
    "contract_references": {"type": "array", "minItems": 6, "items": {"type": "object", "additionalProperties": false, "required": ["document_id", "document_version", "document_digest"], "properties": {"document_id": {"type": "string", "minLength": 1}, "document_version": {"type": "integer", "minimum": 1}, "document_digest": {"$ref": "#/$defs/digest"}}}},
    "pool_access": {"type": "object", "additionalProperties": false, "required": ["development", "selection", "power_pilot", "release_holdout"], "properties": {"development": {"const": "available"}, "selection": {"const": "unopened"}, "power_pilot": {"const": "unopened"}, "release_holdout": {"const": "unopened"}}},
    "pool_rules": {"type": "object", "additionalProperties": false, "required": ["construction_rule_id", "near_duplicate_rule_id", "side_assignment_rule_id", "schedule_rule_id"], "properties": {"construction_rule_id": {"type": "string", "minLength": 1}, "near_duplicate_rule_id": {"type": "string", "minLength": 1}, "side_assignment_rule_id": {"type": "string", "minLength": 1}, "schedule_rule_id": {"type": "string", "minLength": 1}}},
    "budget_profiles": {"type": "object", "additionalProperties": false, "required": ["deployment_utility", "mechanism_ablation"], "properties": {"deployment_utility": {"$ref": "#/$defs/budgetProfile"}, "mechanism_ablation": {"$ref": "#/$defs/budgetProfile"}}},
    "decision_gates": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["comparison_id", "decision_id", "version", "primary_metric_id", "estimand_id", "analysis_procedure_id", "minimum_effect", "confidence_level", "confidence_sidedness", "go_rule_id", "stop_rule_id", "pivot_rule_id", "tie_break_metric_id", "tie_break_direction"], "properties": {"comparison_id": {"type": "string", "minLength": 1}, "decision_id": {"type": "string", "minLength": 1}, "version": {"type": "integer", "minimum": 1}, "primary_metric_id": {"const": "battle_outcome_weighted_v1"}, "estimand_id": {"const": "paired_mean_difference_v1"}, "analysis_procedure_id": {"const": "weighted_cluster_bootstrap_v1"}, "minimum_effect": {"const": 0.05}, "confidence_level": {"const": 0.95}, "confidence_sidedness": {"const": "one_sided"}, "go_rule_id": {"const": "lower_confidence_bound_at_least_minimum_effect_v1"}, "stop_rule_id": {"const": "no_effect_stop_v1"}, "pivot_rule_id": {"const": "uncertain_effect_pivot_v1"}, "tie_break_metric_id": {"const": "end_to_end_latency_ms_v1"}, "tie_break_direction": {"const": "lower_is_better"}}}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "budgetView": {"type": "object", "additionalProperties": false, "required": ["wall_time_budget_ms", "cpu_time_budget_ms", "work_value", "work_unit"], "properties": {"wall_time_budget_ms": {"type": ["integer", "null"], "minimum": 0}, "cpu_time_budget_ms": {"type": ["integer", "null"], "minimum": 0}, "work_value": {"type": ["integer", "null"], "minimum": 1}, "work_unit": {"type": "string", "minLength": 1}}},
    "budgetProfile": {"type": "object", "additionalProperties": false, "required": ["profile_id", "mode", "deployment", "mechanism", "calibrated_parameter", "ordered_work_grid", "total_work_formula", "calibration_spec_digest"], "properties": {"profile_id": {"type": "string", "minLength": 1}, "mode": {"const": "calibrated_grid"}, "deployment": {"$ref": "#/$defs/budgetView"}, "mechanism": {"$ref": "#/$defs/budgetView"}, "calibrated_parameter": {"const": "per_world_work"}, "ordered_work_grid": {"const": [64, 128, 256, 512]}, "total_work_formula": {"const": "world_sampling_count_times_per_world_work"}, "calibration_spec_digest": {"$ref": "#/$defs/digest"}}}
  }
}
