@@ -207,0 +208,123 @@ def test_legal_choices_uses_canonical_lowercase_choice_strings():
+
+
+def _order_state(
+    *,
+    side_one_speed=100,
+    side_two_speed=100,
+    side_one_moves=None,
+    side_two_moves=None,
+    side_one_reserve=False,
+    side_two_reserve=False,
+):
+    side_one_pokemon = [
+        _pokemon(
+            "squirtle",
+            side_one_moves or [Move(id="tackle", pp=32), Move(id="leer", pp=32)],
+            speed=side_one_speed,
+        )
+    ]
+    side_two_pokemon = [
+        _pokemon(
+            "charmander",
+            side_two_moves or [Move(id="tackle", pp=32), Move(id="leer", pp=32)],
+            speed=side_two_speed,
+        )
+    ]
+    if side_one_reserve:
+        side_one_pokemon.append(_pokemon("pikachu", [Move(id="tackle", pp=32)], speed=1))
+    if side_two_reserve:
+        side_two_pokemon.append(_pokemon("bulbasaur", [Move(id="tackle", pp=32)], speed=1))
+    return State(
+        side_one=Side(pokemon=side_one_pokemon),
+        side_two=Side(pokemon=side_two_pokemon),
+        weather="none",
+        weather_turns_remaining=-1,
+        terrain="none",
+        terrain_turns_remaining=-1,
+        trick_room=False,
+        trick_room_turns_remaining=-1,
+    )
+
+
+def _orders(state, side_one_choice, side_two_choice):
+    before = state.to_string()
+    branches = generate_instructions(state, side_one_choice, side_two_choice)
+    assert state.to_string() == before
+    assert branches
+    assert all(isinstance(branch.percentage, float) for branch in branches)
+    assert all(isinstance(branch.instruction_list, list) for branch in branches)
+    return branches
+
+
+def test_resolved_action_order_uses_the_native_ordinary_speed_branch():
+    branches = _orders(_order_state(side_one_speed=120, side_two_speed=80), "tackle", "tackle")
+
+    assert {branch.resolved_action_order for branch in branches} == {("p1", "p2")}
+
+
+def test_resolved_action_order_uses_the_native_reversed_speed_branch():
+    branches = _orders(_order_state(side_one_speed=80, side_two_speed=120), "tackle", "tackle")
+
+    assert {branch.resolved_action_order for branch in branches} == {("p2", "p1")}
+
+
+def test_resolved_action_order_uses_the_native_priority_branch():
+    branches = _orders(
+        _order_state(
+            side_one_speed=1,
+            side_two_speed=999,
+            side_one_moves=[Move(id="quickattack", pp=32)],
+        ),
+        "quickattack",
+        "tackle",
+    )
+
+    assert {branch.resolved_action_order for branch in branches} == {("p1", "p2")}
+
+
+def test_resolved_action_order_uses_the_native_switch_move_branch():
+    branches = _orders(
+        _order_state(side_one_reserve=True), "pikachu", "tackle"
+    )
+
+    assert {branch.resolved_action_order for branch in branches} == {("p1", "p2")}
+
+
+def test_resolved_action_order_uses_the_native_switch_switch_branch():
+    branches = _orders(
+        _order_state(
+            side_one_speed=120,
+            side_two_speed=80,
+            side_one_reserve=True,
+            side_two_reserve=True,
+        ),
+        "pikachu",
+        "bulbasaur",
+    )
+
+    assert {branch.resolved_action_order for branch in branches} == {("p1", "p2")}
+
+
+def test_resolved_action_order_exposes_both_native_speed_tie_branches():
+    branches = _orders(_order_state(), "leer", "leer")
+
+    assert {branch.resolved_action_order for branch in branches} == {("p1", "p2"), ("p2", "p1")}
+    assert sum(branch.percentage for branch in branches) == pytest.approx(1.0)
+
+
+def test_resolved_action_order_tera_uses_the_same_native_order_path():
+    branches = _orders(
+        _order_state(side_one_speed=120, side_two_speed=80), "tackle-tera", "tackle"
+    )
+
+    assert {branch.resolved_action_order for branch in branches} == {("p1", "p2")}
+
+
+def test_resolved_action_order_keeps_same_state_speed_tie_branches_distinct():
+    state = _order_state()
+    branches = _orders(state, "leer", "leer")
+    successor_states = {state.apply_instructions(branch).to_string() for branch in branches}
+
+    assert len(branches) == 2
+    assert len(successor_states) == 1
+    assert {branch.resolved_action_order for branch in branches} == {("p1", "p2"), ("p2", "p1")}
