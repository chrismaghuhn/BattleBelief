     with pytest.raises(ValueError):
         generate_instructions(state, "not_a_move", "ember")
+
+
+def _pokemon(name, moves, *, hp=100):
+    return Pokemon(
+        id=name,
+        level=100,
+        types=("normal", "typeless"),
+        base_types=("normal", "typeless"),
+        hp=hp,
+        maxhp=100,
+        attack=100,
+        defense=100,
+        special_attack=100,
+        special_defense=100,
+        speed=100,
+        moves=moves,
+    )
+
+
+def _legal_choice_state(side_one, *, force_switch=False, force_trapped=False):
+    return State(
+        side_one=Side(
+            pokemon=side_one,
+            force_switch=force_switch,
+            force_trapped=force_trapped,
+        ),
+        side_two=Side(pokemon=[_pokemon("charmander", [Move(id="ember", pp=32)])]),
+        weather="none",
+        weather_turns_remaining=-1,
+        terrain="none",
+        terrain_turns_remaining=-1,
+        trick_room=False,
+        trick_room_turns_remaining=-1,
+    )
+
+
+def test_legal_choices_returns_multiple_ordinary_moves():
+    ordinary = _legal_choice_state(
+        [_pokemon("squirtle", [Move(id="watergun", pp=32), Move(id="tackle", pp=32)])]
+    )
+
+    assert legal_choices(ordinary) == (["watergun", "tackle"], ["ember"])
+
+
+def test_legal_choices_excludes_disabled_and_zero_pp_moves():
+    disabled = _legal_choice_state(
+        [
+            _pokemon(
+                "squirtle",
+                [
+                    Move(id="tackle", pp=32, disabled=True),
+                    Move(id="watergun", pp=0),
+                ],
+            )
+        ]
+    )
+
+    assert legal_choices(disabled)[0] == ["No Move"]
+    generate_instructions(disabled, "watergun", "ember")
+    assert "watergun" not in legal_choices(disabled)[0]
+
+
+def test_legal_choices_includes_legal_switches_with_canonical_prefix():
+    switching = _legal_choice_state(
+        [
+            _pokemon("squirtle", [Move(id="tackle", pp=32)]),
+            _pokemon("pikachu", [Move(id="tackle", pp=32)]),
+        ]
+    )
+
+    assert legal_choices(switching)[0] == ["tackle", "switch pikachu"]
+
+
+def test_legal_choices_excludes_switches_when_trapped():
+    trapped = _legal_choice_state(
+        [_pokemon("squirtle", [Move(id="tackle", pp=32)]), _pokemon("pikachu", [])],
+        force_trapped=True,
+    )
+
+    assert legal_choices(trapped)[0] == ["tackle"]
+
+
+def test_legal_choices_force_switch_contains_only_native_switches():
+    forced = _legal_choice_state(
+        [_pokemon("squirtle", [Move(id="tackle", pp=32)]), _pokemon("pikachu", [])],
+        force_switch=True,
+    )
+
+    assert legal_choices(forced)[0] == ["switch pikachu"]
+    assert "tackle" not in legal_choices(forced)[0]
+
+
+def test_legal_choices_does_not_mutate_the_python_state():
+    before = state.to_string()
+
+    legal_choices(state)
+
+    assert state.to_string() == before
+
+
+def test_legal_choices_uses_canonical_lowercase_choice_strings():
+    choices = legal_choices(state)
+
+    assert all(choice == choice.lower() for side in choices for choice in side)
+    assert choices[0] == ["watergun", "tackle", "quickattack", "leer"]
